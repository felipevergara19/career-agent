# Usuario Linux local para que Docker no cree archivos como root
UID=1000
GID=1000

# PostgreSQL
POSTGRES_USER=career
POSTGRES_PASSWORD=career_secret_pass
POSTGRES_DB=career_agent

# Neo4j (GraphRAG + Neo4j Browser en http://localhost:7474)
NEO4J_AUTH=neo4j/career_neo4j_pass

# Proveedor de IA (configura AL MENOS UNO para evaluación real con rúbrica + GraphRAG)
# Opción 1: OpenRouter (1 sola llave para Gemini, Claude, GPT, DeepSeek y modelos :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Opción 2: Google AI Studio (capa gratuita en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativas soportadas automáticamente:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
